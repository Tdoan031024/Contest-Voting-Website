datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum SponsorTier {
  PLATINUM
  GOLD
  SILVER
  PARTNER
}

model Candidate {
  id                             String   @id @default(uuid())
  sbd                            String   @unique
  name                           String
  votes                          Int      @default(0)
  imageUrl                       String
  description                    String   @db.Text
  biography                      String?  @db.Text
  teamName                       String?
  representativeSchool           String?
  leaderName                     String?
  leaderPhone                    String?
  leaderEmail                    String?
  advisorName                    String?
  members                        String?  @db.Text
  implementationLocation         String?
  intellectualPropertyCommitment Boolean? @default(false)
  supportNeeds                   String?  @db.Text
  expectations                   String?  @db.Text
  contestTable                   String?
  contestTableLabel              String?
  currentRound                   String?  @default("Vòng loại")
  status                         String?  @default("Đủ hồ sơ")
  sector                         String?
  showcaseImages                 String?  @db.Text
  createdAt                      DateTime @default(now())
  updatedAt                      DateTime @updatedAt
}

model Sponsor {
  id            String      @id @default(uuid())
  name          String
  logoUrl       String
  tier          SponsorTier @default(PARTNER)
  description   String?     @db.Text
  websiteUrl    String?
  email         String?
  phone         String?
  contactPerson String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Banner {
  id        String   @id @default(uuid())
  title     String
  imageUrl  String
  link      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TimelineEvent {
  id          String   @id @default(uuid())
  date        String
  title       String
  description String   @db.Text
  isActive    Boolean  @default(true)
  round       String   @default("Vòng loại")
  isImportant Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model VoteRecord {
  id            String   @id @default(uuid())
  candidateId   String
  voterPhone    String
  voteTime      DateTime @default(now())
  transactionId String?
}

model AdminUser {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  role         String   @default("admin")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model WebUser {
  id              String   @id @default(uuid())
  fullName        String
  email           String   @unique
  phone           String?
  passwordHash    String?
  provider        String   @default("email")
  role            String   @default("USER")
  status          String   @default("ACTIVE")
  schoolOrCompany String?
  contestTable    String?
  registeredAt    DateTime @default(now())
  lastLoginAt     DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
